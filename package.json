{
  "name": "@gumi-conqueror/bmh-file",
  "version": "1.0.0",
  "description": "Read and write original Windows BMHelper beta 4 prime files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumi-conqueror/bmh-file.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && tsc -p tests/tsconfig.json && node --test tests/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^26.6.6"
  }
